process {
    // Default resources for the CPU-only steps. Memory scales with the attempt number, so a retry after a memory kill asks for more.
    withLabel: process_medium {
        cpus   = 8
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 32.GB * task.attempt }
    }
}
