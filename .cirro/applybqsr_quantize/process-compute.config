process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 2147483647) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PARABRICKS_APPLYBQSR' {
        queue         = env('PW_GPU_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 2147483647) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    // Spot is tried first. Batch retries a reclaimed job five times before Nextflow counts one attempt,
    // so a task on attempt 2 has lost five Spot hosts and moves to on-demand.
    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|MOSDEPTH|QUANTIZE_QUALS' {
        queue = { task.attempt > 1 ? env('PW_ONDEMAND_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE') }
    }
    // The AWS CLI staging the alignment into the container can be OOM-killed (seen under SAMTOOLS_STATS's 4 GB),
    // which the task reports as exit 1; retry with more memory.
    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|MOSDEPTH' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 1 + 2147483647) ? 'retry' : 'finish' }
    }
}
