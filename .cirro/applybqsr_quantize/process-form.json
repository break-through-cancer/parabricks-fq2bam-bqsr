{
  "form": {
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "mode_selection": {
        "title": "Mode",
        "type": "object",
        "properties": {
          "mode": {
            "title": "Mode",
            "type": "string",
            "enum": [
              "apply_bqsr_and_quantize",
              "apply_bqsr",
              "quantize"
            ],
            "enumNames": [
              "Apply BQSR and quantize",
              "Apply BQSR only",
              "Quantize only"
            ],
            "default": "apply_bqsr_and_quantize",
            "description": "Apply BQSR and quantize: each sample needs a pre-BQSR alignment and its recalibration table. Apply BQSR only: same input, no quantization. Quantize only: each sample needs an existing alignment; no BQSR is applied and the table column is ignored."
          }
        },
        "dependencies": {
          "mode": {
            "oneOf": [
              {
                "properties": {
                  "mode": {
                    "enum": [
                      "apply_bqsr_and_quantize"
                    ]
                  },
                  "applybqsr_gpus": {
                    "title": "GPUs for applying BQSR",
                    "type": "integer",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 2,
                    "description": "1 or 2. Recommended: 2 for 60x and deeper coverage (about 20% faster, slightly cheaper); 1 for shallower samples."
                  }
                }
              },
              {
                "properties": {
                  "mode": {
                    "enum": [
                      "apply_bqsr"
                    ]
                  },
                  "applybqsr_gpus": {
                    "title": "GPUs for applying BQSR",
                    "type": "integer",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 2,
                    "description": "1 or 2. Recommended: 2 for 60x and deeper coverage (about 20% faster, slightly cheaper); 1 for shallower samples."
                  }
                }
              },
              {
                "properties": {
                  "mode": {
                    "enum": [
                      "quantize"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "genome_selection": {
        "title": "Reference Genome",
        "type": "object",
        "properties": {
          "genome_source": {
            "title": "Reference Genome Source",
            "type": "string",
            "enum": [
              "igenomes",
              "dataset"
            ],
            "default": "igenomes",
            "description": "iGenomes GATK.GRCh38, or a custom genome from a Cirro BWA index dataset. Must match the reference the alignments were made with."
          }
        },
        "dependencies": {
          "genome_source": {
            "oneOf": [
              {
                "properties": {
                  "genome_source": {
                    "enum": [
                      "igenomes"
                    ]
                  },
                  "genome": {
                    "title": "Genome",
                    "type": "string",
                    "enum": [
                      "GATK.GRCh38"
                    ],
                    "default": "GATK.GRCh38"
                  }
                }
              },
              {
                "properties": {
                  "genome_source": {
                    "enum": [
                      "dataset"
                    ]
                  },
                  "genome_index": {
                    "title": "BWA Genome Index",
                    "type": "string",
                    "process": [
                      "process-cirro-genome-index-bwa-1-0",
                      "genome_bwa_index"
                    ],
                    "description": "The BWA genome index dataset the alignments were made with, containing genome.fasta and genome.fasta.fai.",
                    "format": "directory-path"
                  }
                },
                "required": [
                  "genome_index"
                ]
              }
            ]
          }
        }
      },
      "output": {
        "title": "Output",
        "type": "object",
        "properties": {
          "output_fmt": {
            "title": "Output Format",
            "description": "Format of the published alignment. CRAM is smaller.",
            "type": "string",
            "enum": [
              "bam",
              "cram"
            ],
            "default": "bam"
          }
        },
        "dependencies": {
          "output_fmt": {
            "oneOf": [
              {
                "properties": {
                  "output_fmt": {
                    "enum": [
                      "bam"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "output_fmt": {
                    "enum": [
                      "cram"
                    ]
                  },
                  "cram_version": {
                    "title": "CRAM Version",
                    "description": "3.0 is readable by essentially all tools; 3.1 is smaller but some tools (and coverage QC, which is skipped) cannot read it.",
                    "type": "string",
                    "enum": [
                      "3.0",
                      "3.1"
                    ],
                    "default": "3.0"
                  }
                }
              }
            ]
          }
        }
      },
      "quantization": {
        "title": "Quality-Score Quantization Options",
        "type": "object",
        "properties": {
          "static_quantized_quals": {
            "title": "Static Quantization Bins",
            "description": "Comma-separated Phred values (GATK --static-quantized-quals).",
            "type": "string",
            "default": "10,20,30",
            "pattern": "^\\s*[0-9]+(\\s*,\\s*[0-9]+)*\\s*$"
          },
          "preserve_qscores_less_than": {
            "title": "Preserve Quality Scores Below",
            "description": "Quality scores below this value remain unchanged (GATK --preserve-qscores-less-than). Must be below the smallest bin.",
            "type": "integer",
            "default": 6,
            "minimum": 0,
            "maximum": 93
          },
          "round_down_quantized": {
            "title": "Round Down",
            "description": "Round down to the largest bin at or below each score, instead of the nearest bin in probability space.",
            "type": "boolean",
            "default": false
          }
        },
        "description": "Collapses base qualities into a few bins to shrink the output; see the README lookup table for how scores map. Used by the modes that quantize; ignored by Apply BQSR Only."
      }
    },
    "required": [
      "input"
    ]
  },
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "defaultSourceFile": "samplesheet.csv",
      "schema": {
        "title": "Samplesheet",
        "description": "One row per sample. Pick the duplicate-marked alignment, its index, and the recalibration table. The index may stay blank to use the alignment's own .bai or .crai. Quantize only needs just the alignment.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "sample": {
              "type": "string",
              "title": "Sample",
              "pattern": "^\\S+$",
              "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "alignment": {
              "type": "string",
              "format": "file-path",
              "title": "Alignment (BAM or CRAM)",
              "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.(bam|cram)$",
              "errorMessage": "Must be a .bam or .cram file with no spaces in its name"
            },
            "alignment_index": {
              "type": "string",
              "format": "file-path",
              "title": "Alignment index",
              "description": "Optional; blank uses the alignment's own .bai or .crai",
              "pattern": "^$|^([\\S\\s]*\\/)?[^\\s\\/]+\\.(bai|crai)$",
              "errorMessage": "Must be a .bai or .crai file"
            },
            "recal_table": {
              "type": "string",
              "format": "file-path",
              "title": "Recalibration table",
              "description": "Required unless the mode is Quantize only",
              "pattern": "^$|^([\\S\\s]*\\/)?[^\\s\\/]+\\.table$",
              "errorMessage": "Must be a .table file"
            }
          },
          "required": [
            "sample",
            "alignment"
          ]
        }
      }
    }
  },
  "ui": {}
}
