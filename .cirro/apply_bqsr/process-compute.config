process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PARABRICKS_APPLYBQSR' {
        accelerator   = 1
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 2147483647) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withName: 'QUANTIZE_QUALS|SAMTOOLS_FINALIZE' {
        memory = { 8.GB * task.attempt }
    }
    // Cheap QC steps: the AWS CLI staging the alignment into the container can be OOM-killed
    // (seen under SAMTOOLS_STATS's 4 GB), which the task reports as exit 1; retry with more memory.
    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|MOSDEPTH' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 1 + 2147483647) ? 'retry' : 'finish' }
    }
}
